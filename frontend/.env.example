# Copy to frontend/.env.local (gitignored).
#
# false: call the real backend at http://127.0.0.1:8000 (start it first; see
#        backend/.env.example for the API keys it needs).
# true:  run on recorded sample data (src/mocks/demo/). No backend or API keys needed.
#        `npm run dev:demo` does the same without editing this file, and the hosted
#        demo is built that way (`npm run build:demo`).
VITE_USE_MOCKS=false
