# FlightGuard backend settings
# ----------------------------------------------------------------------------------
# Copy this file to backend/.env and fill in your own keys. Never commit backend/.env.
# Every key is optional: each one turns on a feature, and the app tells you
# clearly when something isn't connected. All services below have free tiers.
#
# Want to try the app without any keys? Skip the backend entirely and run the
# frontend in demo mode (`npm run dev:demo`). It uses recorded sample data.
# ----------------------------------------------------------------------------------


# --- Flight search (needed to look up real flights) ---------------------------------
# AeroDataBox via RapidAPI: flight schedules, live status, and flight numbers for map planes.
# 1. Create a free RapidAPI account and subscribe to the Basic (free) plan:
#    https://rapidapi.com/aedbx-aedbx/api/aerodatabox
# 2. Copy the "X-RapidAPI-Key" shown on the API's page.
# Without it, searches show "Live flight data isn't connected" (or use DEMO_MODE below).
# The free plan has a small monthly quota; the backend caches lookups for 10 minutes.
AERODATABOX_API_KEY=


# --- Carbon footprint ------------------------------------------------------------
# Google Travel Impact Model: per-passenger CO2e for each flight.
# 1. In Google Cloud Console, create a project and enable the "Travel Impact Model API":
#    https://developers.google.com/travel/impact-model
# 2. Create an API key (APIs & Services -> Credentials) and paste it here.
# Without it, emissions fall back to a rough distance-based estimate.
GOOGLE_TIM_API_KEY=


# --- Live map (aircraft positions) ---------------------------------------------------
# OpenSky Network API client (OAuth2 client credentials). Free for non-commercial use.
# 1. Create an account at https://opensky-network.org
# 2. Open your Account page and create an API client, then copy its ID and secret.
# Without them the map still works anonymously, but with a much lower daily limit.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=


# --- Weather and airport status (no keys needed) -------------------------------------
# Used by the delay forecast. Leave these as they are.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
FAA_NAS_URL=https://nasstatus.faa.gov/api/airport-status-information


# --- Backend demo mode ---------------------------------------------------------------
# true:  /api/flights/lookup serves one recorded sample flight (DL1234 on 2026-10-11)
#        without calling AeroDataBox, plus recorded weather and FAA data. Handy for
#        testing the backend with no keys.
# false: use the real APIs above. Set this to false once you've added your keys.
DEMO_MODE=true
